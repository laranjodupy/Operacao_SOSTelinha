# Copie os VALORES para Settings > Environment Variables na Vercel.
# Não envie este arquivo com segredos para o Git.
APP_URL=https://SEU-PROJETO.vercel.app
DATABASE_URL=postgresql://postgres.REF:SENHA_URL_ENCODED@HOST_POOLER:6543/postgres
DATABASE_SSL=true
ADMIN_EMAIL=SEU_EMAIL
# Prefira ADMIN_PASSWORD_HASH gerado por scripts/hash-password.mjs
ADMIN_PASSWORD_HASH=
DEMO_MODE=true
AI_PROVIDER=n8n
N8N_AI_WEBHOOK_URL=https://SEU_N8N/webhook/SEU_CAMINHO
N8N_AI_SECRET=
AI_TIMEOUT_MS=90000
WHATSAPP_PROVIDER=evolution
WHATSAPP_BASE_URL=https://SUA_EVOLUTION
WHATSAPP_INSTANCE=
WHATSAPP_API_KEY=
WEBHOOK_SECRET=
ALLOW_INSECURE_LOCAL_INTEGRATIONS=false
