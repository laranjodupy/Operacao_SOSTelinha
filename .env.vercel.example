# Copie os VALORES para Settings > Environment Variables na Vercel.
# Não envie este arquivo com segredos para o Git.
APP_URL=https://SEU-PROJETO.vercel.app
SUPABASE_URL=https://SEU-PROJETO.supabase.co
AUTH_PROVIDER=supabase
SUPABASE_PUBLISHABLE_KEY=sb_publishable_COLE_A_CHAVE_REAL
SUPABASE_SECRET_KEY=sb_secret_COLE_A_CHAVE_REAL
ADMIN_EMAIL=SEU_EMAIL
# ADMIN_EMAIL deve corresponder ao usuário criado em Supabase > Authentication > Users.
# A senha é definida no Supabase Auth, não nas variáveis da Vercel.
DEMO_MODE=true
AI_PROVIDER=n8n
N8N_AI_WEBHOOK_URL=https://SEU_N8N/webhook/SEU_CAMINHO
N8N_AI_SECRET=
AI_TIMEOUT_MS=90000
WHATSAPP_PROVIDER=evolution
WHATSAPP_BASE_URL=https://SUA_EVOLUTION
WHATSAPP_INSTANCE=
WHATSAPP_API_KEY=
WEBHOOK_SECRET=
ALLOW_INSECURE_LOCAL_INTEGRATIONS=false
