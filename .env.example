# Copie este arquivo para .env.local. Não publique credenciais no Git.
# Node.js 24 LTS ou mais recente. Use um processo Node + disco persistente.
APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@minhaloja.com
ADMIN_PASSWORD=Neynohexa@2010
# Opcional, em vez de ADMIN_PASSWORD: node scripts/hash-password.mjs
# ADMIN_PASSWORD_HASH=sal:hash-scrypt-hex
DATABASE_PATH=./data/tray-balcao.sqlite
DEMO_MODE=true

# local: palavras-chave, sem IA; n8n: webhook; cloudflare: REST Workers AI
AI_PROVIDER=local
N8N_AI_WEBHOOK_URL=
N8N_AI_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct

# demo: histórico local; evolution: adaptador Evolution API v2
WHATSAPP_PROVIDER=demo
WHATSAPP_BASE_URL=
WHATSAPP_INSTANCE=
WHATSAPP_API_KEY=
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=
# Somente para integrações executadas no mesmo computador:
ALLOW_INSECURE_LOCAL_INTEGRATIONS=false
